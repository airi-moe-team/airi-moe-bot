# ============================================================
# Airi — configuración de entorno
# Copia este archivo a .env y ajusta lo que necesites.
# Todas las claves numéricas son OPCIONALES: si faltan, se usa el
# valor por defecto indicado entre paréntesis.
# ============================================================

# --- Conexión (obligatorias) ---
DISCORD_TOKEN=tu_token_de_discord
# Canal(es) autorizado(s). Acepta varios ids separados por comas:
#   CHANNEL_IDS=111111111111111111,222222222222222222
# Compatibilidad: CHANNEL_ID=<id> (canal único) también funciona.
CHANNEL_IDS=0
# URL del backend LLM. Admite la raíz de un llama.cpp local O la raíz (con o
# sin /v1) de cualquier API compatible con Chat Completions. `LLAMA_URL` sigue
# funcionando como alias histórico de esta variable.
LLM_BASE_URL=http://127.0.0.1:8081

# --- Proveedor / perfil LLM ---
# Perfil de compatibilidad:
#   llama              → llama.cpp local (default; sin clave; /health en raíz;
#                        envía chat_template_kwargs de desactivar thinking)
#   openai             → API de OpenAI (Bearer obligatorio; /v1/models;
#                        max_completion_tokens por defecto)
#   openai-compatible  → OpenRouter, Groq, vLLM, LM Studio... (mismas rutas
#                        que OpenAI pero max_tokens por defecto)
LLM_PROVIDER=llama
# Clave API para perfiles remotos (también se acepta OPENAI_API_KEY).
# En `llama` déjala vacía.
LLM_API_KEY=
# Clave de salida del payload: por defecto `max_tokens` (llama y
# openai-compatible) o `max_completion_tokens` (openai). Descomenta SOLO para
# anular el default del perfil (p. ej. un compatible que exige
# max_completion_tokens, o modelos openai aún con max_tokens).
# LLM_MAX_TOKENS_FIELD=
# 1 → omitir `temperature` del payload (modelos razonadores de OpenAI que la
# rechazan). No asumas que todos la rechazan: actívala solo si tu modelo lo exige.
LLM_SKIP_TEMPERATURE=0
# 1 → enviar `response_format` (json_object / json_schema estricto) cuando un
# servicio pide schema. Pon 0 si tu proveedor compatible lo rechaza.
LLM_RESPONSE_FORMAT=1
# 1 → comprobar el backend antes de cada turno: `/health` (raíz) en perfil
# llama, `GET /v1/models` en perfiles remotos. Un fallo remoto solo avisa en
# el log y el turno continúa; en `llama` el fallo aborta el turno (histórico).
# Pon 0 para no comprobar nada (recomendado si tu compatible no expone /models).
LLM_HEALTH_CHECK=1

# --- Modelo LLM ---
# Nombre del modelo a conectar (GGUF local por defecto; en perfiles remotos
# debe ser un modelo de esa API, p. ej. gpt-4o-mini — si se deja el default
# con un proveedor remoto, el bot avisa en el arranque).
LLM_MODEL=Qwen3.6-35B-A3B-MTP-UD-IQ3_S
# Timeout en segundos para las peticiones al modelo (0 = sin límite).
LLM_TIMEOUT=300
# Temperatura de generación (0.0–2.0; 0 = determinista, >1 = creativa).
LLM_TEMPERATURE=0.6
# Techo total de contexto del servidor (`-c` en llama-server): prompt +
# generación. El cliente recorta historial antes de llamar para no superarlo.
LLM_CONTEXT_TOKENS=50000
# Salida máxima que el bot pide por llamada principal (turno y juicio).
LLM_OUTPUT_TOKENS=7000
# Cortafuegos global del cliente para llamadas sin max_tokens explícito.
# Tokens máximos de salida (-1 = sin límite).
LLM_MAX_TOKENS=8000

# --- APIs opcionales ---
BRAVE_API_KEY=
NEKOSBEST_CONTACT=
OWNER_ID=0

# --- Directorio de datos ---
# Directorio raíz para datos persistentes (memorias, diario, etc.).
# También se acepta el prefijo AIRI_ (AIRI_DATA_DIR).
DATA_DIR=data

# --- Observabilidad (Fase 5) ---
# Directorio de trazas en disco (vacío = solo ring en memoria). Se acepta el
# prefijo AIRI_ (AIRI_TRACE_DIR) o el nombre histórico (TRACE_DIR).
TRACE_DIR=./traces
# Incluir la respuesta cruda del modelo en la traza (1 = reproducible
# con `python -m airi.replay`; 0 = ahorra disco a costa de no poder
# reproducir el turno exacto).
TRACE_KEEP_RAW=1
# Tamaño del ring en memoria (eventos inspeccionables con `!debug`).
# También como AIRI_TRACE_KEEP_LAST.
TRACE_KEEP_LAST=500

# ============================================================
# PARÁMETROS NUMÉRICOS (default)
#
# OJO: las constantes de dominio (DATE_*, LLM_*) se leen AL IMPORTAR:
# editar el .env con el bot corriendo NO las aplica hasta reiniciarlo.
# ============================================================

# --- Modelo / red ---
MAX_HISTORY_MESSAGES=12
REQUEST_TIMEOUT=300
MAX_WEB_RESULTS=5
DEBOUNCE_SECONDS=2.5
GIF_TIMEOUT=20
# Tokens máximos al reformular consulta de búsqueda web.
SEARCH_QUERY_MAX_TOKENS=64

# --- Afinidad y niveles (game.py) ---
CONFESS_THRESHOLD=100
FRIENDZONE_CAP=44
AFFINITY_FLOOR=-100
AFFINITY_DELTA_MIN=-5
AFFINITY_DELTA_MAX=5
DECAY_PER_DAY=1
AFFINITY_BAR_WIDTH=8

# --- Citas (game.py) ---
DATE_MAX_TURNS=6
DATE_CRISIS_MIN_TURNS=3
DATE_END_MIN_TURNS=4
# Turnos mínimos para que la PALABRA de fin ("fin", "adiós"...) cierre la cita
# (con match por palabra completa: "final"/"afinidad" ya no cuentan).
DATE_END_KEYWORD_MIN_TURNS=2
DATE_CRISIS_DROP=4
DATE_LAST_CHANCE_MAX_RECOVERY=12
DATE_HISTORY_MAX=20
DATE_MAX_SECONDS=300

# --- Citas: pregunta decisiva ---
# Turnos mínimos antes de poder preguntar, turno en que se fuerza y gracia de
# turnos extra sobre DATE_MAX_TURNS para que la pregunta forzada quepa.
DATE_QUESTION_MIN_TURNS=2
DATE_QUESTION_FORCE_TURN=4
DATE_QUESTION_GRACE_TURNS=2
# Segundos que la pregunta puede esperar sin respuesta antes de caducar.
DATE_QUESTION_TIMEOUT=180
# Segundos mínimos para lanzar la pregunta (si no, se avisa y se omite) y
# margen con el que se alarga la cita cuando la pregunta es forzada.
DATE_QUESTION_MIN_SECONDS=60
DATE_QUESTION_TIME_MARGIN=15

# --- Citas (bot.py, en segundos) ---
DATE_COOLDOWN=21600
DATE_BUSY_NOTICE_COOLDOWN=30
DATE_DELTA_MAX=8

# --- Citas: UI generada por la IA ---
DATE_SCENE_MAX=4
DATE_ACTION_MAX=4
DATE_ACTION_LABEL_MAX=80
# Tokens máximos al pedir escenas de cita al modelo.
DATE_SCENE_MAX_TOKENS=300

# --- Regalos ---
GIFT_COOLDOWN=86400
MAX_RECENT_GIFTS=3

# --- Memorias ---
MAX_MEMORIES_PER_USER=15
MAX_MEMORY_CHARS=160

# --- Diario ---
DIARY_MAX_ENTRIES=300
DIARY_VIEW_LIMIT=10
DIARY_REFLECTION_MIN_INTERVAL=600
KNOWN_USERS_PROMPT_MAX=10
DIARY_PROMPT_MAX_USER=6
DIARY_PROMPT_MAX_CHARS=900

# Resumen de la cita al cerrarla (entrada de diario generada por el LLM).
DATE_SUMMARY_MAX_TOKENS=220
DATE_SUMMARY_MAX_CHARS=400

# --- Antilazo (repeticiones) ---
REPETITION_THRESHOLD=4

# --- Avisos y respuesta automática al arrancar ---
# 1 = Airi se despide/anuncia al conectar/desconectar en los canales autorizados.
AIRI_ONLINE_NOTICE=1
# 1 = al arrancar, responde al último mensaje que quedó sin respuesta.
AIRI_ANSWER_PENDING_ON_START=1
# Antigüedad máxima (segundos) del mensaje pendiente que se responderá.
AIRI_PENDING_MAX_AGE=86400
