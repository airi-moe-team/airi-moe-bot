# ============================================================
# Airi — configuración de entorno
# Copia este archivo a .env y ajusta lo que necesites.
# Todas las claves numéricas son OPCIONALES: si faltan, se usa el
# valor por defecto indicado entre paréntesis.
# ============================================================

# --- Conexión (obligatorias) ---
DISCORD_TOKEN=tu_token_de_discord
CHANNEL_ID=0
# Perfil del backend: llama (local), openai o openai-compatible.
LLM_PROVIDER=llama
# URL base del proveedor; también acepta una URL que ya termine en /v1.
LLM_BASE_URL=http://127.0.0.1:7000
# Clave para proveedores remotos (también se acepta OPENAI_API_KEY).
LLM_API_KEY=
# Campo de tokens: automático (openai=max_completion_tokens; otros=max_tokens).
# Vacío para usar el campo predeterminado del proveedor.
LLM_MAX_TOKENS_FIELD=
# Opciones de compatibilidad para proveedores que rechazan ciertos parámetros.
LLM_SKIP_TEMPERATURE=0
LLM_RESPONSE_FORMAT=1
# Comprueba /health en llama o /v1/models en proveedores remotos.
LLM_HEALTH_CHECK=1
# Razonamiento siempre activo con llama. auto usa presupuesto bajo en turnos
# rápidos y el default del servidor en normales; on usa default del servidor.
# low/medium/high limitan reasoning a 256/1024/4096 tokens por petición.
# Requiere soporte de thinking_budget_tokens en el build llama.cpp; un
# --reasoning-budget fijado en el servidor puede impedir el override por petición.
LLM_THINKING_MODE=auto

# --- Modelo LLM ---
# Identificador EXACTO del modelo que sirve el backend. Consúltalo en
# GET {LLM_BASE_URL}/v1/models: llama.cpp suele devolver la ruta del .gguf.
LLM_MODEL=Qwen3.6-35B-A3B-MTP-UD-IQ3_S
# Timeout en segundos para las peticiones al modelo (0 = sin límite).
LLM_TIMEOUT=300
# Temperatura de generación (0.0–2.0; 0 = determinista, >1 = creativa).
LLM_TEMPERATURE=0.6
# Tokens máximos de salida (-1 = sin límite). Un tope bajo responde antes y
# evita que el modelo divague; 1500 deja respuestas largas sin eternizarse.
LLM_MAX_TOKENS=1500
# Tope de salida para turnos breves (saludos y mensajes cortos sin web/cita).
LLM_SHORT_MAX_TOKENS=600

# --- APIs opcionales ---
BRAVE_API_KEY=
# Habilita tool calling web. La decisión de invocar la búsqueda la toma Airi.
AIRI_WEB_SEARCH=1
# Contacto real para el User-Agent de NekosBest (email o URL pública).
NEKOSBEST_CONTACT=
OWNER_ID=0

# --- Directorio de datos ---
# Directorio raíz para datos persistentes (memorias, diario, etc.).
# También se acepta el prefijo AIRI_ (AIRI_DATA_DIR).
DATA_DIR=data

# --- Persistencia y recuperación ---
# Copias de migración que se conservan.
AIRI_BACKUP_RETENTION=5
# Temporadas archivadas que se conservan.
AIRI_SEASON_RETENTION=3
# Segundos para republicar una respuesta confirmada pendiente tras reiniciar.
AIRI_PUBLISH_TTL_SECONDS=900
# Segundos que se conserva un turno ya resuelto en el registro durable.
AIRI_TURN_RETENTION_SECONDS=604800

# --- Identidad editable (self model) ---
SELF_TRAIT_MIN=1
SELF_TRAIT_MAX=5
# Rasgos permitidos y sus valores base deben configurarse juntos como JSON.
# La base del env manda al arrancar: Airi aprende DESVIACIONES sobre ella
# (persistidas en traits_learned) y el decaimiento la devuelve a la base.
SELF_TRAITS_ALLOWLIST='["expresiva","timida","juguetona","celosa","sarcastica","curiosa"]'
SELF_BASE_TRAITS='{"expresiva":4,"timida":3,"juguetona":5,"celosa":2,"sarcastica":2,"curiosa":4}'
SELF_CONCEPT_MAX_CHARS=400
SELF_MAX_VALUES=5
SELF_VALUE_MAX_CHARS=40
SELF_MAX_QUIRKS=8
SELF_QUIRK_MAX_CHARS=80
SELF_DISCOVERY_MAX_CHARS=200
SELF_NOTES_MAX=50
SELF_HISTORY_MAX=200
SELF_HISTORY_VIEW_LIMIT=10
# Entre dos cambios de identidad y por clave (segundos).
SELF_UPDATE_MIN_INTERVAL=3600
# Máximo de cambios por la misma clave durante SELF_KEY_DAILY_SECONDS;
# debe ser <= SELF_HISTORY_MAX para que el historial permita contarlos.
SELF_KEY_DAILY_LIMIT=1
SELF_KEY_DAILY_SECONDS=86400
# Deriva lenta de los rasgos hacia su valor base.
SELF_DECAY_DAYS=7
SELF_DECAY_STEP=1
# Reflexión introspectiva automática.
SELF_REFLECTION_EVERY_N=10
SELF_REFLECTION_MIN_INTERVAL=3600
SELF_REFLECTION_MAX_TOKENS=300

# --- Observabilidad (Fase 5) ---
# Directorio de trazas en disco (vacío = solo ring en memoria). Se acepta el
# prefijo AIRI_ (AIRI_TRACE_DIR) o el nombre histórico (TRACE_DIR).
TRACE_DIR=
# Tamaño del ring en memoria (eventos inspeccionables con `!debug`).
# También como AIRI_TRACE_KEEP_LAST.
TRACE_KEEP_LAST=500

# ============================================================
# PARÁMETROS NUMÉRICOS (default)
# ============================================================

# --- Modelo / red ---
MAX_HISTORY_MESSAGES=12
REQUEST_TIMEOUT=300
MAX_WEB_RESULTS=5
# Espera para agrupar mensajes seguidos antes de responder. Más bajo = responde
# antes; súbelo si la persona suele escribir en varias líneas.
DEBOUNCE_SECONDS=1.0
GIF_TIMEOUT=20
# Tokens máximos de la decisión de búsqueda web (tool calling).
# Se acepta SEARCH_QUERY_MAX_TOKENS como alias histórico.
WEB_SEARCH_DECISION_MAX_TOKENS=128
# Turno rápido: longitud máxima del mensaje y mensajes de historial visibles.
QUICK_REPLY_MAX_CHARS=60
QUICK_HISTORY_MESSAGES=6

# --- Afinidad y niveles (game.py) ---
CONFESS_THRESHOLD=100
FRIENDZONE_CAP=44
AFFINITY_FLOOR=-100
AFFINITY_DELTA_MIN=-5
AFFINITY_DELTA_MAX=5
DECAY_PER_DAY=1
AFFINITY_BAR_WIDTH=8
# Umbrales y etiquetas ordenados por umbral, como pares [puntos, nombre] en JSON.
# El séptimo nivel (índice 6) es el mínimo actual para poder tener una cita.
AFFINITY_LEVELS='[[-100,"Bloqueada"],[-50,"Enfadada"],[-20,"Molesta"],[-1,"Distante"],[0,"Desconocida"],[10,"Conocida"],[25,"Amiga"],[45,"Cercana"],[70,"Muy cercana"],[100,"Inseparables"]]'

# --- Citas (game.py) ---
DATE_MAX_TURNS=6
DATE_CRISIS_MIN_TURNS=3
DATE_END_MIN_TURNS=4
DATE_CRISIS_DROP=4
DATE_LAST_CHANCE_MAX_RECOVERY=12
DATE_HISTORY_MAX=20
DATE_MAX_SECONDS=300
# Escenas de reserva/opciones para citas, como lista JSON de cadenas no vacías.
DATE_SCENES='["un paseo por el parque al atardecer","una tarde en una cafetería acogedora","una sesión de cine con palomitas","un día en la playa","una cena a la luz de las velas","una feria con luces de colores"]'

# --- Citas (bot.py, en segundos) ---
DATE_COOLDOWN=21600
DATE_BUSY_NOTICE_COOLDOWN=30
DATE_DELTA_MAX=8

# --- Citas: pregunta decisiva opcional (una sola vez por cita) ---
# Turnos mínimos antes de poder preguntar (1 = la IA decide si y cuándo).
DATE_QUESTION_MIN_TURNS=1
# Alternativas máximas de la pregunta.
DATE_QUESTION_OPTIONS=3
# Swing máximo de afinidad que puede mover una respuesta (±).
DATE_QUESTION_DELTA_MAX=25
# Desplome a partir del cual la respuesta se considera un fallo grave.
DATE_QUESTION_CRISIS_DROP=20
# Segundos que los botones de la pregunta permanecen activos.
DATE_QUESTION_TIMEOUT=180
# Segundos que le quedan a la cita como mínimo para poder preguntar.
DATE_QUESTION_MIN_SECONDS=60
# Holgura extra (segundos) al alargar una cita antigua con pregunta forzada.
DATE_QUESTION_TIME_MARGIN=15

# --- Afinidad visible en el prompt ---
# "recipient" (por defecto): el modelo solo ve la afinidad de quien le habla.
# "all": ve la afinidad de cada interlocutor, cada uno con la suya.
AFFINITY_VIEW_SCOPE=recipient

# --- Citas: UI generada por la IA ---
DATE_SCENE_MAX=4
DATE_ACTION_LABEL_MAX=80
# Tokens máximos al pedir escenas de cita al modelo.
DATE_SCENE_MAX_TOKENS=300

# --- Regalos ---
GIFT_COOLDOWN=86400
MAX_RECENT_GIFTS=3

# --- Memorias ---
MAX_MEMORIES_PER_USER=15
MAX_MEMORY_CHARS=160

# --- Diario ---
DIARY_MAX_ENTRIES=300
DIARY_VIEW_LIMIT=10
DIARY_REFLECTION_MIN_INTERVAL=600
KNOWN_USERS_PROMPT_MAX=10
DIARY_PROMPT_MAX_USER=6
DIARY_PROMPT_MAX_CHARS=900

# --- Antilazo (repeticiones) ---
REPETITION_THRESHOLD=4

# --- Modo espectador (escucha pasiva) ---
AIRI_TIME_CONTEXT=1                 # Percepción temporal; 0 la desactiva para A/B o rollback
AIRI_TIMEZONE=                      # Zona IANA opcional (p. ej. Europe/Madrid); vacío usa la zona del sistema
AIRI_CONVERSATION_REVIEW=1           # Revisión semántica del hilo antes de publicar; 0 la desactiva
# Si el contenedor corre en UTC, define TZ=Europe/Madrid o AIRI_TIMEZONE=Europe/Madrid.
AIRI_SPECTATOR_ENABLED=0
AIRI_SPECTATOR_BUFFER_MAX=20
AIRI_SPECTATOR_TTL_SECONDS=1800
AIRI_SPECTATOR_AFFINITY_POINTS=20
AIRI_SPECTATOR_PROB_TOPIC=0.55
AIRI_SPECTATOR_PROB_AFFINITY=0.35
AIRI_SPECTATOR_COOLDOWN_SECONDS=300
AIRI_SPECTATOR_HANDOFF_SECONDS=180   # ventana para responder a la pregunta de Airi
AIRI_SPECTATOR_SNAPSHOT_MAX=12
AIRI_SPECTATOR_ACTIVE_IDLE_SECONDS=300
AIRI_SPECTATOR_PROACTIVE_IDLE_SECONDS=21600
AIRI_SPECTATOR_PENDING_MAX_AGE_SECONDS=3600

# Perfil estable de gustos (JSON). Si está definida y es válida, prevalece
# sobre lo persistido y sobre cualquier cambio posterior de identidad.
# AIRI_PROFILE='{"loves":["videojuegos","ramen"],"dislikes":["grosero"],"favorite_food":"postres y dulces","favorite_flower":"las rosas"}'
